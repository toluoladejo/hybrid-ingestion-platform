# Only needed if you DON'T use `scripts/configure-watermark.sh --from-terraform`.
# Copy to watermark.env (git-ignored), fill in, then run: scripts/configure-watermark.sh
SQL_SERVER=sql-wm-dev-xxxxxxxxxxxxx      # server name, without .database.windows.net
SQL_DB=rto_watermark_test
STORAGE_ACCOUNT=stingestdevxxxxxxxxxxxxx
SYNAPSE_WORKSPACE=syn-ingest-dev-xxxxxxxxxxxxx
# Optional. If set, it is written into the pipeline JSON (and so into Git). Leave it empty
# and paste the URL into the Debug dialog's AlertWebhookUrl parameter instead.
ALERT_URL=''
