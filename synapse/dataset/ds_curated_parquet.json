{
  "name": "ds_curated_parquet",
  "properties": {
    "linkedServiceName": { "referenceName": "ls_lake", "type": "LinkedServiceReference" },
    "parameters": {
      "folder": { "type": "string" },
      "fileName": { "type": "string" }
    },
    "type": "Parquet",
    "typeProperties": {
      "location": {
        "type": "AzureBlobFSLocation",
        "fileSystem": "curated",
        "folderPath": { "value": "@dataset().folder", "type": "Expression" },
        "fileName": { "value": "@dataset().fileName", "type": "Expression" }
      },
      "compressionCodec": "snappy"
    }
  }
}
